{
  "name": "homebridge-eta-rest",
  "displayName": "Homebridge ETA REST",
  "version": "1.0.0",
  "description": "Homebridge plugin for ETA pellet boilers using the ETA REST API.",
  "author": "Kestral",
  "license": "Apache-2.0",

  "homepage": "https://github.com/kestral-homekit/homebridge-eta-rest",
  "repository": {
    "type": "git",
    "url": "https://github.com/kestral-homekit/homebridge-eta-rest.git"
  },
  "bugs": {
    "url": "https://github.com/kestral-homekit/homebridge-eta-rest/issues"
  },

  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "eta",
    "boiler",
    "pellet",
    "heating",
    "rest",
    "temperature"
  ],

  "type": "module",

  "main": "dist/index.js",
  "types": "dist/index.d.ts",

  "engines": {
    "node": ">=18.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },

  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },

  "homebridge": {
    "pluginAlias": "EtaRestV3",
    "pluginType": "platform"
  },

  "dependencies": {
    "homebridge-lib": "^7.1.12"
  },

  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  }
}
